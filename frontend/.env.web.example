# Firebase config goes in frontend/.env (shared by the desktop renderer and the web app): paste the values from
# Firebase console > Project settings > Your apps > Web app. They are public identifiers (safe to commit); access is
# enforced by Firestore rules and Firebase Auth. frontend/.env.web only switches the backend for the hosted build:
VITE_BACKEND=firebase

# Firebase App Check for the hosted app (optional): a reCAPTCHA v3 site key registered for todoease.com in
# Firebase console > App Check. Empty = App Check off. See docs/DEVELOPMENT.md ("Abuse protection").
VITE_RECAPTCHA_SITE_KEY=
