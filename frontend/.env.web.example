# Copy to frontend/.env.web and paste the values from Firebase console > Project settings > Your apps > Web app.
# These are public identifiers (safe to commit); access is enforced by Firestore rules and Firebase Auth.
VITE_BACKEND=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
