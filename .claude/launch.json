{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "web"
      ],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "backend/MyTodoEase.Api"
      ],
      "port": 5080
    },
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:site"
      ],
      "port": 5174
    },
    {
      "name": "web-scratch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "VITE_API_URL=http://localhost:5081",
        "npm",
        "run",
        "dev",
        "-w",
        "frontend",
        "--",
        "--port",
        "5175"
      ],
      "port": 5175
    }
  ]
}
