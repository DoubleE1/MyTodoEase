rules_version = '2';

// Every document lives under users/{uid}/...; a signed-in user can read and write only their own tree.
// That tree holds the task data and, in cloud mode, what the in-app Google Calendar sync records for the
// account: calendarSync/{settings,status,calendars,lock}, calendarLinks (task -> event) and calendarEvents
// (events pulled from Google). No Google credential is ever stored here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{collection}/{document} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && collection in ['projects', 'sections', 'labels', 'tasks', 'completions',
                          'calendarSync', 'calendarLinks', 'calendarEvents'];
    }
  }
}
