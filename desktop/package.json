{
  "name": "todoease-desktop",
  "productName": "TodoEase",
  "private": true,
  "version": "0.2.7",
  "description": "TodoEase desktop shell",
  "author": "TodoEase",
  "main": "main.cjs",
  "scripts": {
    "dev": "wait-on http-get://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "start": "electron .",
    "build": "electron-builder --publish never",
    "release": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.mytodoease.desktop",
    "electronVersion": "41.7.1",
    "productName": "TodoEase",
    "directories": {
      "output": "../release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "build/api",
        "to": "api",
        "filter": [
          "**/*",
          "!*.pdb",
          "!appsettings.Development.json"
        ]
      },
      {
        "from": "build/appbar",
        "to": "appbar",
        "filter": [
          "**/*",
          "!*.pdb"
        ]
      },
      {
        "from": "build/mcp",
        "to": "mcp",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TodoEase",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "dbo-e",
      "repo": "TodoEase",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
